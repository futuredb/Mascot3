{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["contract", "version", "model", "prefix", "suffix", "entries"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "pet_generation_v2.animation_prompt_catalog.v1" },
    "version": { "type": "integer", "minimum": 1 },
    "model": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "minLength": 1 },
    "suffix": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
          "required": ["id", "availability", "template", "duration_seconds", "source_hash", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "availability": { "enum": ["enabled", "disabled"] },
          "template": { "type": "string", "minLength": 1 },
          "duration_seconds": { "type": "integer", "minimum": 4, "maximum": 10 },
          "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "verified": { "type": "object", "required": ["verdict"], "properties": { "verdict": { "enum": ["pending_verification", "pending_manual_review", "accepted", "rejected"] }, "job": { "type": "string" }, "framing_qa": { "type": "object" }, "notes": { "type": "string" } } }
        }
      }
    }
  }
}
