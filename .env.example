# Required only for paid generation. Never put this value in the Android app.
OPENROUTER_API_KEY=

# Required for a public deployment. The Android beta build sends this token
# only to the Mascot API; it is not the OpenRouter provider key.
MASCOT3_CLIENT_TOKEN=

# Optional model overrides. Defaults come from Pet Generation v2.5.
PET_V2_TEXT_MODEL=openai/gpt-5.6-terra-pro
IMAGE_RENDER_MODEL=google/gemini-3.1-flash-image-preview
PET_V2_VIDEO_MODEL=bytedance/seedance-2.0-mini
PET_V2_VIDEO_RESOLUTION=720p
PET_V2_VIDEO_PRICE_PER_SECOND_USD=0.076125
PET_V2_MAX_ANIMATION_COST_USD=3

MASCOT3_PORT=8788
MASCOT3_DATA_DIR=/data
MASCOT3_MAX_HERO_STARTS_PER_DAY=5
MASCOT3_ENABLE_LEGACY_API=false
MASCOT3_ALLOW_ACCOUNT_DELETE=false
MASCOT3_MAX_HERO_COST_USD=5
MASCOT3_BASE_COST_RESERVE_USD=1.75
MASCOT3_MAX_ANIMATION_COST_USD=3
MASCOT3_VIDEO_PRICE_PER_SECOND_USD=0.076125
